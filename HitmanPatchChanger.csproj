<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HitmanPatchChanger</RootNamespace>
    <AssemblyName>HitmanPatchChanger</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="patches.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="patches.json" LogicalName="patches.json" />
    <EmbeddedResource Include="wwwroot/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.0" />
  </ItemGroup>
</Project>
